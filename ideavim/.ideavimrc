" ================================================================================================
" 🍰🍰🍰 Extensions 🍰🍰🍰
" ================================================================================================

"下列插件需要在IDEA中下载
"ideaVim
"IdeaVimExtension

" ================================================================================================
" 🐧🐧🐧 Basic settings 🐧🐧🐧
" ================================================================================================
"--开启surround(包裹功能)
set surround
"设置在光标距离窗口顶部或底部一定行数时，开始滚动屏幕内容的行为
set scrolloff=10

"--递增搜索功能：在执行搜索（使用 / 或 ? 命令）时，
"Vim 会在您输入搜索模式的过程中逐步匹配并高亮显示匹配的文本。
set incsearch

"--在搜索时忽略大小写
set ignorecase

"--将搜索匹配的文本高亮显示
set hlsearch

"--设置相对行号 和 当前行的绝对行号
set number relativenumber

"--设置返回normal模式时回到英文输入法
set keep-english-in-normal

"--vim寄存器同步系统剪切板
set clipboard=unnamedplus

" ================================================================================================
" keyboard mapping
" ================================================================================================
 " 空格作 <leader>
let mapleader = " "

" 使用 gc 作为注释操作符
nmap gc <Action>(CommentByLineComment)
vmap gc <Action>(CommentByLineComment)

"--快速上下移动
nmap J 5j
nmap K 5k

" 移动光标
nnoremap <C-f> <PageDown>
nnoremap <C-b> <PageUp>

" 插入模式快速退出
nnoremap <C-j> <Esc>
inoremap <C-j> <Esc>
vnoremap <C-j> <Esc>
snoremap <C-j> <Esc>
xnoremap <C-j> <Esc>
onoremap <C-j> <Esc>
cnoremap <C-j> <C-c>

nnoremap <C-k> <Esc>
inoremap <C-k> <Esc>
vnoremap <C-k> <Esc>
snoremap <C-k> <Esc>
xnoremap <C-k> <Esc>
onoremap <C-k> <Esc>
cnoremap <C-k> <C-c>

" 保存/退出
nmap <leader>w <action>(SaveAll)

" 按文件名搜索（等同 Goto File）
nnoremap <leader>ff :action GotoFile<CR>
" 按内容搜索（Find in Files / Find in Path）
nnoremap <leader>fg :action FindInPath<CR>

" bookmark 切换书签
nmap ma <action>(ToggleBookmark)

"切换标签页
noremap H ^
noremap L $
" 在已打开的 Tab 间切换（下一个）
nnoremap <leader><leader> <C-^>

" 分屏
nnoremap <leader>sv :action SplitHorizontally<CR>
nnoremap <leader>sh :action SplitVertically<CR>
nnoremap <leader>sx :action Unsplit<CR>
" map <leader>sx <C-w>c
" 分屏焦点切换（左右上下）
" 上下两个方向有时也复用 Next/PrevSplitter；若需要精确方向，可改用下两行：
nmap <leader>jj <c-w>j
nmap <leader>hh <c-w>h
nmap <leader>kk <c-w>k
nmap <leader>ll <c-w>l

" 代码导航/帮助：
nnoremap gD :action GotoDeclaration<CR>
nnoremap gd :action GotoImplementation<CR>
nnoremap gi :action GotoTypeDeclaration<CR>
nnoremap K  :action QuickDocumentation<CR>
nnoremap <C-k> :action QuickDocumentation<CR>

" 重命名 / 意图动作 / 查找引用 / 格式化：
nnoremap <leader>r :action RenameElement<CR>
nnoremap <leader>a :action ShowIntentionActions<CR>
nnoremap gr :action FindUsages<CR>
nnoremap <leader>fc :action ReformatCode<CR>

" ; —— 快速进入命令行
nnoremap ; :

" Ctrl+h —— 取消搜索高亮
nnoremap <C-h> :nohlsearch<CR>
vnoremap <C-h> :nohlsearch<CR>

" 左右方向键 —— 在 Tab 之间切换
nnoremap <Left>  :action PreviousTab<CR>
nnoremap <Right> :action NextTab<CR>

"在可视模式中：删除选择的文本并复制到剪切板
vmap <leader>dd "+d

"打断点/解除断点
nmap <leader>bp <Action>(ToggleLineBreakpoint)
"调试
nmap <leader>db <Action>(Debug)

" 格式化代码
nmap <leader>fm <action>(ReformatCode) \| <action>(OptimizeImports)

"在当前目录新建文件夹
nmap <leader>nd <action>(NewDir)
nmap <leader>nf <action>(NewFIle)

" ==== 搜索结果自动居中 ====
nnoremap n nzz
nnoremap N Nzz
nnoremap * *zz
nnoremap # #zz
nnoremap g* g*zz

" ==== “very magic” 缺省搜索 ====
nnoremap / /\v
nnoremap ? ?\v
cnoremap %s/ %sm/

" ==== 禁用方向键，强迫用 hjkl ====
nnoremap <Up> <Nop>
nnoremap <Down> <Nop>
inoremap <Up> <Nop>
inoremap <Down> <Nop>
inoremap <Left> <Nop>
inoremap <Right> <Nop>

" ==== 软折行时 j/k 走“视觉行”====
nnoremap j gj
nnoremap k gk

" Redo
nnoremap U <C-r>
